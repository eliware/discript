# Discript application configuration.
# Copy this file to .env or ~/.discript.env and replace secret placeholders.

# Discord bot token. Keep this value private and never commit the populated file.
DISCORD_TOKEN=your_discord_bot_token

# Optional comma-separated Discord gateway intents.
# Defaults to Guilds,GuildMessages,GuildMembers.
DISCRIPT_INTENTS=Guilds,GuildMessages,GuildMembers

# Optional execution profile. Direct mode is the default when omitted.
# DISCRIPT_CONNECTION_MODE=direct

# Daemon profile. Used when DISCRIPT_CONNECTION_MODE=daemon.
# DISCRIPT_DAEMON_MODE=socket

# MCP server profile. Supported values are planned/configured by the MCP mode:
# stdio, http, or https.
# DISCRIPT_MCP_TRANSPORT=http
# DISCRIPT_MCP_HOST=127.0.0.1
# DISCRIPT_MCP_PORT=8765
# Optional separate listeners; set both to enable HTTP-to-HTTPS redirects.
# DISCRIPT_MCP_HTTP_PORT=8765
# DISCRIPT_MCP_HTTPS_PORT=8766
# DISCRIPT_MCP_ENDPOINT=/mcp

# MCP authentication: none, static, bearer-passthrough, or oauth2.
# Never commit a real token or client secret.
# DISCRIPT_MCP_AUTH_MODE=static
# DISCRIPT_MCP_AUTH_TOKEN=replace_me
# DISCRIPT_MCP_OAUTH_ISSUER=https://auth.example.com
# DISCRIPT_MCP_OAUTH_RESOURCE=https://discript.example.com/mcp
# DISCRIPT_MCP_OAUTH_REQUIRED_SCOPES=discord:read,discord:write
# DISCRIPT_MCP_OAUTH_INTROSPECTION_ENDPOINT=https://auth.example.com/introspect
# DISCRIPT_MCP_OAUTH_CLIENT_ID=discript-resource-server
# DISCRIPT_MCP_OAUTH_CLIENT_SECRET=replace_me

# MCP TLS configuration. Prefer mounted secret files for deployed services.
# DISCRIPT_MCP_TLS_KEY_FILE=/path/to/tls-key.pem
# DISCRIPT_MCP_TLS_CERT_FILE=/path/to/tls-cert.pem
# DISCRIPT_MCP_TLS_CA_FILE=/path/to/tls-ca.pem
# DISCRIPT_MCP_HTTP_REDIRECT=true
# DISCRIPT_MCP_ALLOWED_ORIGINS=https://agent.example.com

# Remote MCP client profile.
# DISCRIPT_CLIENT_URL=https://discript.example.com/mcp
# DISCRIPT_CLIENT_TRANSPORT=http
# DISCRIPT_CLIENT_TOKEN=replace_me
# DISCRIPT_CLIENT_HEADERS={"X-Agent":"discript"}
# For stdio client mode:
# DISCRIPT_CLIENT_COMMAND=discript
# DISCRIPT_CLIENT_ARGS=["mcp","--stdio"]
# DISCRIPT_CLIENT_RECONNECT=true
# DISCRIPT_CLIENT_RECONNECT_BASE_DELAY=1000
# DISCRIPT_CLIENT_RECONNECT_MAX_DELAY=60000
# DISCRIPT_CLIENT_MAX_RECONNECT_ATTEMPTS=10

# Test-only value. Keep this in a project-specific .env, not the normal
# user-level application profile.
# TEST_GUILD=your_test_guild_id
