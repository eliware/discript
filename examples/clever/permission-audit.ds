// Report permission overwrites for every channel without changing state.
guildId = env.TEST_GUILD
if (guildId == null) {
  exit(2, "set TEST_GUILD")
}
guild = discord.guilds.get(guildId)
for (channel in guild.channels.list()) {
  if (channel.type == 0) {
    print({channelId: channel.id, channelName: channel.name, permissions: discord.channels.get(channel.id).permissions.list()})
  }
}
// Mini tutorial: permission audit.
// This example demonstrates composition, decision-making, and resilient workflows.
// Run it with: discript examples/clever/permission-audit.ds (or pipe it to discript for stdin mode).
// Read the final value and comments together to follow the data flow.
