// Find channels that expose the most useful automation surfaces.
channelId = env.DISCORD_CHANNEL_ID
if (channelId == null) {
  exit(2, "set DISCORD_CHANNEL_ID")
}

channel = discord.channels.get(channelId)
print({
  id: channel.id,
  name: channel.name,
  type: channel.type,
  threads: channel.threads.list(),
  webhooks: channel.webhooks.list(),
  permissions: channel.permissions.list()
})
// Mini tutorial: channel capability report.
// This example demonstrates composition, decision-making, and resilient workflows.
// Run it with: discript examples/clever/channel-capability-report.ds (or pipe it to discript for stdin mode).
