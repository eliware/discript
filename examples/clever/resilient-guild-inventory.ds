// Keep collecting inventory when one guild lookup fails.
guilds = discord.guilds.list()
for (guild in guilds) {
  result = try {
    live = discord.guilds.get(guild.id)
    {ok: true, id: live.id, name: live.name, channels: live.channels.list()}
  } catch (error) {
    {ok: false, id: guild.id, error: {code: error.code, message: error.message}}
  }
  print(result)
}
// Mini tutorial: resilient guild inventory.
// This example demonstrates composition, decision-making, and resilient workflows.
// Run it with: discript examples/clever/resilient-guild-inventory.ds (or pipe it to discript for stdin mode).
// Read the final value and comments together to follow the data flow.
