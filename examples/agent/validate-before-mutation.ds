guildId = "<guild-id>"
channelId = "<channel-id>"
content = "agent validation message"

guild = discord.guilds.get(guildId)
channel = discord.channels.get(channelId)
if (guild.id != guildId || channel.id != channelId) {
  exit(2, "target validation failed")
}

discord.channels.get(channelId).send(content, {dryRun: true})
// Mini tutorial: validate before mutation.
// This example demonstrates agent-friendly input, structured output, and safe automation.
// Run it with: discript examples/agent/validate-before-mutation.ds (or pipe it to discript for stdin mode).
// Read the final value and comments together to follow the data flow.
/* Tutorial focus: The workflow separates validation from mutation so an agent can inspect the proposed target before approving a change. */
