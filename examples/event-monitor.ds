on("messageCreate") {
  if (event.author.bot != true) {
    print({channelId: event.channelId, content: event.content})
  }
}

every(60000) {
  print({status: "monitoring"})
}
// Mini tutorial: event monitor.
// This example demonstrates Discript scripting fundamentals.
// Run it with: discript examples/event-monitor.ds (or pipe it to discript for stdin mode).
// Read the final value and comments together to follow the data flow.
/* Tutorial focus: This demonstrates registering a Gateway event handler and keeping the process alive intentionally. */
